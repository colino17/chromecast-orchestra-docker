#!/usr/bin/env bash
# ccorc - fleet manager for Chromecast with Google TV devices, over ADB (fixed port 5555).
# Runs inside the container; see README.md. `ccorc help` lists commands.
set -u

DATA="${CCORC_DATA:-/data}"
PORT="${CCORC_PORT:-5555}"
JOBS="${CCORC_JOBS:-4}"                      # devices handled in parallel
INTERVAL="${CCORC_INTERVAL:-30}"             # monitor loop period (seconds)
PLAY_TIMEOUT="${CCORC_PLAY_TIMEOUT:-300}"    # max wait per Play Store install (seconds)
OPENER="${CCORC_OPENER:-com.cxinventor.file.explorer/com.alphainventor.filemanager.activity.MainActivity}"
REMOTE_DIR="${CCORC_REMOTE_DIR:-/storage/emulated/0/Documents}"
DEVICES="$DATA/devices.conf"
M="$DATA/manifest"
APKS="$DATA/apks"
SETTINGS="$DATA/settings"
UPDATE=0
WITH_SETTINGS=0

log() { printf '%s %s\n' "$(date '+%T')" "$*"; }
die() { echo "error: $*" >&2; exit 1; }

# ---------------------------------------------------------------- helpers

devices()  { awk 'NF && $1 !~ /^#/ { print $1, $2 }' "$DEVICES"; }      # "name ip"
manifest() { awk 'NF && $1 !~ /^#/ { print $1 }' "$1"; }                 # first column
match()    { [[ "$1" == all ]] || [[ ",$1," == *",$2,"* ]]; }             # target selector

is_up() {
  timeout 8 adb connect "$1:$PORT" >/dev/null 2>&1 </dev/null
  [[ "$(timeout 5 adb -s "$1:$PORT" get-state 2>/dev/null </dev/null)" == device ]]
}

# ------------------------------------------------- per-device operations
# These run inside fanout(), where SERIAL is "<ip>:<port>".

A() { adb -s "$SERIAL" "$@" </dev/null; }
S() { A shell "$@" | tr -d '\r'; }

refresh() {
  PKGS="$(S pm list packages)"
  DIS="$(S pm list packages -d)"
  [[ -n "$PKGS" ]]
}
has()         { grep -qx "package:$1" <<<"$PKGS"; }
is_disabled() { grep -qx "package:$1" <<<"$DIS"; }

do_uninstall() {
  local p out rc=0
  refresh || return 1
  for p in "$@"; do
    has "$p" || continue
    out="$(S pm uninstall --user 0 "$p" 2>&1)"
    if [[ "$out" == *Success* ]]; then echo "uninstalled $p"; else echo "FAILED uninstall $p: $out"; rc=1; fi
  done
  return $rc
}

do_disable() {
  local p out rc=0
  refresh || return 1
  for p in "$@"; do
    has "$p" || continue
    is_disabled "$p" && continue
    out="$(S pm disable-user --user 0 "$p" 2>&1)"
    if [[ "$out" == *disabled* ]]; then echo "disabled $p"; else echo "FAILED disable $p: $out"; rc=1; fi
  done
  return $rc
}

do_install() {
  local f out rc=0
  for f in "$@"; do
    [[ -f "$f" ]] || { echo "FAILED: no such file $f"; rc=1; continue; }
    echo "installing $(basename "$f")"
    out="$(A install -r "$f" 2>&1)"
    [[ "$out" == *Success* ]] || { echo "FAILED install $f: $out"; rc=1; }
  done
  return $rc
}

# Opens the Play Store page, presses the focused button once, then polls until installed.
do_playstore() {
  local p i rc=0
  for p in "$@"; do
    refresh || return 1
    has "$p" && continue
    echo "play store: $p"
    A shell input keyevent 224                       # wake
    A shell am start -a android.intent.action.VIEW -d "market://details?id=$p" >/dev/null
    sleep 6
    A shell input keyevent 23                        # DPAD_CENTER on "Install"
    for (( i = 0; i < PLAY_TIMEOUT; i += 5 )); do
      sleep 5
      refresh; has "$p" && break
    done
    if has "$p"; then echo "installed $p"; else echo "FAILED play store install $p (re-run to retry)"; rc=1; fi
  done
  return $rc
}

# grants.txt: each non-comment line is run as a shell command on the device.
do_grants() {
  local line rc=0
  while IFS= read -r line; do
    [[ -z "${line//[[:space:]]/}" || "$line" == \#* ]] && continue
    A shell "$line" >/dev/null 2>&1 || { echo "FAILED: $line"; rc=1; }
  done < "$M/grants.txt"
  return $rc
}

# apks.txt: "<package> <source> [asset-regex]". Installs missing packages (all, with --update-apks).
apk_file() { case "$2" in github:*|http*) echo "$APKS/$1.apk" ;; *) echo "$APKS/$2" ;; esac; }

do_apks() {
  local pkg src pat rc=0
  refresh || return 1
  while read -r pkg src pat; do
    [[ -z "$pkg" || "$pkg" == \#* ]] && continue
    if has "$pkg" && (( ! UPDATE )); then continue; fi
    do_install "$(apk_file "$pkg" "$src")" || rc=1
  done < "$M/apks.txt"
  return $rc
}

# settings.txt: "<file in settings/> [seconds-to-wait]". Pushes the file, then opens it
# in the file explorer so the owning app offers to restore it.
do_settings() {
  local f wait rc=0
  while read -r f wait; do
    [[ -z "$f" || "$f" == \#* ]] && continue
    [[ -f "$SETTINGS/$f" ]] || { echo "FAILED: settings/$f missing"; rc=1; continue; }
    echo "restoring $f (waiting ${wait:-120}s)"
    A push "$SETTINGS/$f" "$REMOTE_DIR/" >/dev/null || { rc=1; continue; }
    A shell am start -n "$OPENER" -a android.intent.action.VIEW -d "file://$REMOTE_DIR/$f" >/dev/null
    sleep "${wait:-120}"
  done < "$M/settings.txt"
  return $rc
}

status_one() { echo "up  $(S getprop ro.product.device)  android $(S getprop ro.build.version.release)"; }

# Full desired-state pass. Order matters: list launchers last in disable.txt.
sync_device() {
  local rc=0
  do_uninstall $(manifest "$M/uninstall.txt") || rc=1
  do_apks                                     || rc=1
  do_playstore $(manifest "$M/playstore.txt") || rc=1
  do_grants                                   || rc=1
  do_disable $(manifest "$M/disable.txt")     || rc=1
  (( ! WITH_SETTINGS )) || do_settings        || rc=1
  return $rc
}

# ---------------------------------------------------------------- fan-out

# fanout <target|all|name,name> <function> [args...]: runs on each device in parallel.
fanout() {
  local target="$1" fn="$2"; shift 2
  local tmp line name ip f n=0 total=0 failed=() DEVS=()
  tmp="$(mktemp -d)"
  mapfile -t DEVS < <(devices)

  for line in "${DEVS[@]}"; do
    read -r name ip <<<"$line"
    match "$target" "$name" || continue
    total=$((total + 1))
    (
      SERIAL="$ip:$PORT"
      if is_up "$ip"; then "$fn" "$@" || touch "$tmp/$name"; else echo "unreachable ($SERIAL)"; touch "$tmp/$name"; fi
    ) 2>&1 | sed -u "s/^/[$name] /" &
    if (( ++n >= JOBS )); then wait -n; n=$((n - 1)); fi
  done
  wait

  for f in "$tmp"/*; do [[ -e "$f" ]] && failed+=("${f##*/}"); done
  rm -rf "$tmp"

  (( total )) || die "no device matches '$target'"
  echo "done: $((total - ${#failed[@]})) ok, ${#failed[@]} failed${failed[*]:+ (${failed[*]})}"
  (( ${#failed[@]} == 0 ))
}

# ---------------------------------------------------------------- apk downloads

resolve_url() { # <source> [asset-regex]
  local pat="${2:-}"; [[ -n "$pat" ]] || pat='\.apk$'
  case "$1" in
    github:*)
      curl -fsSL "https://api.github.com/repos/${1#github:}/releases/latest" \
        | grep -o '"browser_download_url": *"[^"]*"' | cut -d'"' -f4 \
        | grep -E "$pat" | head -1 ;;
    *) echo "$1" ;;
  esac
}

# Downloads github:/http sources once, on the server, before fanning out.
prepare_apks() {
  local pkg src pat url f
  while read -r pkg src pat; do
    [[ -z "$pkg" || "$pkg" == \#* ]] && continue
    case "$src" in github:*|http*) ;; *) continue ;; esac
    f="$APKS/$pkg.apk"
    if [[ -f "$f" ]] && (( ! UPDATE )); then continue; fi
    url="$(resolve_url "$src" "${pat:-}")"
    [[ -n "$url" ]] || { log "could not resolve $src"; continue; }
    log "downloading $pkg"
    if curl -fsSL -o "$f.tmp" "$url"; then mv "$f.tmp" "$f"; else rm -f "$f.tmp"; log "download failed: $url"; fi
  done < "$M/apks.txt"
}

# ---------------------------------------------------------------- monitor

notify() { # log, and POST to CCORC_NOTIFY_URL if set (ntfy, Gotify, Home Assistant webhook...)
  log "$*"
  [[ -z "${CCORC_NOTIFY_URL:-}" ]] || curl -fsS -m 10 -d "$*" "$CCORC_NOTIFY_URL" >/dev/null 2>&1 </dev/null
  return 0
}

declare -A STATE
monitor_pass() {
  local line name ip now DEVS=()
  mapfile -t DEVS < <(devices)
  for line in "${DEVS[@]}"; do
    read -r name ip <<<"$line"
    if is_up "$ip"; then now=up; else now=down; fi
    [[ "${STATE[$name]:-}" == "$now" ]] && continue
    # report every change, plus a device that is already down on first sight
    if [[ -n "${STATE[$name]:-}" || "$now" == down ]]; then notify "[$name] $ip:$PORT is $now"; fi
    STATE[$name]="$now"
  done
}

monitor() {
  local warned=0
  log "monitor: port $PORT, every ${INTERVAL}s${CCORC_NOTIFY_URL:+, notifying}"
  while true; do
    if [[ -n "$(devices)" ]]; then
      warned=0; monitor_pass
    elif (( ! warned )); then
      log "no devices in $DEVICES yet; waiting (edit the file, no restart needed)"; warned=1
    fi
    sleep "$INTERVAL"
  done
}

# ---------------------------------------------------------------- main

usage() {
  cat <<'USAGE'
ccorc <command> [args]      <target> is a device name, a,b,c list, or "all"

  monitor                               log/notify when a device's :5555 goes down or returns (container default)
  status    <target>                    reachability, model, Android version
  sync      <target> [--update-apks] [--settings]
                                        apply data/manifest/* (idempotent)
  uninstall <target> <pkg>...           remove packages for user 0
  disable   <target> <pkg>...           disable packages (pm disable-user)
  install   <target> <apk>...           adb install -r (paths inside the container)
  playstore <target> <pkg>...           install from the Play Store via UI keypress
  grants    <target>                    run manifest/grants.txt on the device
  settings  <target>                    push + restore app backups (settings.txt)
  shell     <target> <command...>       run an ad-hoc device shell command
USAGE
}

# First run: create the folder layout and header-only manifest files (never overwrites).
seed() { [[ -f "$1" ]] || printf '%s\n' "$2" > "$1"; }
init_data() {
  mkdir -p "$M" "$APKS" "$SETTINGS" "$HOME/.android" 2>/dev/null
  seed "$DEVICES"         "# <name> <ip>   e.g.  livingroom-4k 192.168.1.50"
  seed "$M/uninstall.txt" "# packages to uninstall, one per line (do not also list them in playstore.txt)"
  seed "$M/apks.txt"      "# <package> <source> [asset-regex]   source: github:owner/repo | http(s) URL | filename in apks/"
  seed "$M/playstore.txt" "# packages to install from the Play Store, one per line"
  seed "$M/grants.txt"    "# shell commands run on each device, one per line (appops, pm grant, settings put ...)"
  seed "$M/disable.txt"   "# packages to disable, one per line (list launchers last)"
  seed "$M/settings.txt"  "# <file in settings/> [seconds to wait for the restore]"
}

for c in adb curl timeout sed awk; do command -v "$c" >/dev/null 2>&1 || die "missing required command: $c"; done

cmd="${1:-help}"; shift || true
case "$cmd" in help|-h|--help) usage; exit 0 ;; esac

init_data
[[ -f "$DEVICES" ]] || die "cannot create $DEVICES (is the data volume mounted and writable?)"
adb start-server >/dev/null 2>&1

case "$cmd" in
  monitor|keepalive) monitor ;;
  status)    fanout "${1:?target required}" status_one ;;
  sync)
    t="${1:?target required}"; shift
    for a in "$@"; do
      case "$a" in
        --update-apks) UPDATE=1 ;;
        --settings)    WITH_SETTINGS=1 ;;
        *) die "unknown flag: $a" ;;
      esac
    done
    prepare_apks
    fanout "$t" sync_device ;;
  uninstall) t="${1:?target required}"; shift; fanout "$t" do_uninstall "$@" ;;
  disable)   t="${1:?target required}"; shift; fanout "$t" do_disable "$@" ;;
  install)   t="${1:?target required}"; shift; fanout "$t" do_install "$@" ;;
  playstore) t="${1:?target required}"; shift; fanout "$t" do_playstore "$@" ;;
  grants)    fanout "${1:?target required}" do_grants ;;
  settings)  fanout "${1:?target required}" do_settings ;;
  shell)     t="${1:?target required}"; shift; fanout "$t" S "$@" ;;
  *) usage; exit 1 ;;
esac
