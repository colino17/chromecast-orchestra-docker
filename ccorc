#!/usr/bin/env bash
# ccorc - fleet manager for Chromecast with Google TV devices, over ADB (fixed port 5555).
# Runs inside the container. `ccorc help` lists commands.
set -u

DATA="${CCORC_DATA:-/data}"
PORT="${CCORC_PORT:-5555}"
JOBS="${CCORC_JOBS:-4}"                      # devices handled in parallel
PLAY_TIMEOUT="${CCORC_PLAY_TIMEOUT:-300}"    # max wait per Play Store install (seconds)
WEB_PORT="${CCORC_WEB_PORT:-9276}"
WWW="${CCORC_WWW:-/www}"
REMOTE_DIR=/storage/emulated/0/Documents     # where share/ is pushed
DEVICES="$DATA/devices.conf"
M="$DATA/manifest"
APKS="$DATA/apks"
SHARE="$DATA/share"

: "${HOME:=$DATA/home}"; export HOME         # adb keeps its key in $HOME/.android (the web server may start us without HOME)

log() { printf '%s %s\n' "$(date '+%T')" "$*"; }
die() { echo "error: $*" >&2; exit 1; }

# ---------------------------------------------------------------- helpers

rd()       { tr -d '\r' < "$1"; }                                         # file contents without CRs (Windows edits)
devices()  { rd "$DEVICES" | awk 'NF && $1 !~ /^#/ { print $1, $2 }'; }   # "name ip"
manifest() { rd "$1" | awk 'NF && $1 !~ /^#/ { print $1 }'; }             # first column
match()    { [[ "$1" == all ]] || [[ ",$1," == *",$2,"* ]]; }             # target selector

is_up() {
  timeout 8 adb connect "$1:$PORT" >/dev/null 2>&1 </dev/null
  [[ "$(timeout 5 adb -s "$1:$PORT" get-state 2>/dev/null </dev/null)" == device ]]
}

# ------------------------------------------------- per-device operations
# These run inside fanout(), where SERIAL is "<ip>:<port>".

A() { adb -s "$SERIAL" "$@" </dev/null; }
S() { A shell "$@" | tr -d '\r'; }

refresh() {
  PKGS="$(S pm list packages)"
  DIS="$(S pm list packages -d)"
  [[ -n "$PKGS" ]]
}
has()         { grep -qx "package:$1" <<<"$PKGS"; }
is_disabled() { grep -qx "package:$1" <<<"$DIS"; }

do_uninstall() {
  local p out rc=0
  refresh || return 1
  for p in "$@"; do
    has "$p" || continue
    out="$(S pm uninstall --user 0 "$p" 2>&1)"
    if [[ "$out" == *Success* ]]; then echo "uninstalled $p"; else echo "FAILED uninstall $p: $out"; rc=1; fi
  done
  return $rc
}

do_disable() {
  local p out rc=0
  refresh || return 1
  for p in "$@"; do
    has "$p" || continue
    is_disabled "$p" && continue
    out="$(S pm disable-user --user 0 "$p" 2>&1)"
    if [[ "$out" == *disabled* ]]; then echo "disabled $p"; else echo "FAILED disable $p: $out"; rc=1; fi
  done
  return $rc
}

# Opens the Play Store page, presses the focused button once, then polls until installed.
do_playstore() {
  local p i rc=0
  for p in "$@"; do
    refresh || return 1
    has "$p" && continue
    echo "play store: $p"
    A shell input keyevent 224                       # wake
    A shell am start -a android.intent.action.VIEW -d "market://details?id=$p" >/dev/null
    sleep 6
    A shell input keyevent 23                        # DPAD_CENTER on "Install"
    for (( i = 0; i < PLAY_TIMEOUT; i += 5 )); do
      sleep 5
      refresh; has "$p" && break
    done
    if has "$p"; then echo "installed $p"; else echo "FAILED play store install $p (re-run to retry)"; rc=1; fi
  done
  return $rc
}

# apks.txt: "<package> <version> <file in apks/>". Installs when the package is missing or
# <version> is higher than the versionName on the device (self-updated apps are left alone).
ver() { S dumpsys package "$1" | sed -n 's/^ *versionName=//p' | head -1; }

# newer A B: succeeds if version A is higher than B. Compares dot/dash separated segments,
# numerically when both are numbers (so 0.10.0 > 0.9.0), otherwise as text.
newer() {
  local IFS='.-_+' i x y
  local -a a b
  read -ra a <<<"$1"; read -ra b <<<"$2"
  for (( i = 0; i < ${#a[@]} || i < ${#b[@]}; i++ )); do
    x="${a[i]:-0}"; y="${b[i]:-0}"
    [[ "$x" == "$y" ]] && continue
    if [[ "$x" =~ ^[0-9]+$ && "$y" =~ ^[0-9]+$ ]]; then
      (( 10#$x == 10#$y )) && continue
      (( 10#$x > 10#$y )); return
    fi
    [[ "$x" > "$y" ]]; return
  done
  return 1
}

do_apks() {
  local pkg want file have f out rc=0
  refresh || return 1
  while read -r pkg want file; do
    [[ -z "$pkg" || "$pkg" == \#* ]] && continue
    if has "$pkg"; then
      have="$(ver "$pkg")"
      newer "$want" "$have" || continue
      echo "$pkg: $have -> $want"
    fi
    f="$APKS/$file"
    [[ -f "$f" ]] || { echo "FAILED: no such file apks/$file"; rc=1; continue; }
    echo "installing $file"
    out="$(A install -r "$f" 2>&1)"
    [[ "$out" == *Success* ]] || { echo "FAILED install $file: $out"; rc=1; }
  done < <(rd "$M/apks.txt")
  return $rc
}

# Everything in share/ is pushed to the device's Documents folder.
do_share() {
  local f rc=0
  for f in "$SHARE"/*; do
    [[ -e "$f" ]] || continue
    echo "sharing $(basename "$f")"
    A push "$f" "$REMOTE_DIR/" >/dev/null || { echo "FAILED push $f"; rc=1; }
  done
  return $rc
}

# shell.txt: each non-comment line is run as a shell command on the device.
do_shell_file() {
  local line out rc=0
  while IFS= read -r line; do
    [[ -z "${line//[[:space:]]/}" || "$line" == \#* ]] && continue
    if out="$(A shell "$line" 2>&1)"; then echo "ran: $line"; else echo "FAILED: $line${out:+ ($out)}"; rc=1; fi
  done < <(rd "$M/shell.txt")
  return $rc
}

# `input text` needs spaces written as %s and shell-safe quoting; do both so plain text works.
do_text() {
  local t="$*"
  t="${t//$'\r'/ }"; t="${t//$'\n'/ }"       # one line only
  t="${t// /%s}"
  t="${t//\'/\'\\\'\'}"                      # ' -> '\''
  A shell input text "'$t'" && echo "sent"
}

# Full desired-state pass. Order matters: list launchers last in disable.txt.
sync_device() {
  local rc=0
  do_uninstall $(manifest "$M/uninstall.txt") || rc=1
  do_apks                                     || rc=1
  do_playstore $(manifest "$M/playstore.txt") || rc=1
  do_share                                    || rc=1
  do_shell_file                               || rc=1
  do_disable $(manifest "$M/disable.txt")     || rc=1
  return $rc
}

# ---------------------------------------------------------------- fan-out

# fanout <target|all|name,name> <function> [args...]: runs on each device in parallel.
fanout() {
  local target="$1" fn="$2"; shift 2
  local tmp line name ip f n=0 total=0 failed=() DEVS=()
  tmp="$(mktemp -d)"
  mapfile -t DEVS < <(devices)

  for line in "${DEVS[@]}"; do
    read -r name ip <<<"$line"
    match "$target" "$name" || continue
    total=$((total + 1))
    (
      SERIAL="$ip:$PORT"
      if is_up "$ip"; then "$fn" "$@" || touch "$tmp/$name"; else echo "unreachable ($SERIAL)"; touch "$tmp/$name"; fi
    ) 2>&1 | sed -u "s/^/[$name] /" &
    if (( ++n >= JOBS )); then wait -n; n=$((n - 1)); fi
  done
  wait

  for f in "$tmp"/*; do [[ -e "$f" ]] && failed+=("${f##*/}"); done
  rm -rf "$tmp"

  (( total )) || die "no device matches '$target'"
  echo "done: $((total - ${#failed[@]})) ok, ${#failed[@]} failed${failed[*]:+ (${failed[*]})}"
  (( ${#failed[@]} == 0 ))
}

# ---------------------------------------------------------------- web UI

# Serves $WWW with busybox httpd (static page + two small CGI scripts that call ccorc).
# Optional login: set CCORC_WEB_PASS (and CCORC_WEB_USER, default "admin"). No colons in either.
web() {
  local conf=/tmp/httpd.conf
  command -v httpd >/dev/null 2>&1 || die "httpd not found (install the busybox-extras package)"
  if [[ -n "${CCORC_WEB_PASS:-}" ]]; then
    echo "/:${CCORC_WEB_USER:-admin}:$CCORC_WEB_PASS" > "$conf"
  else
    : > "$conf"
    log "web: CCORC_WEB_PASS is not set, so the UI is open to anyone who can reach port $WEB_PORT"
  fi
  log "web: listening on :$WEB_PORT"
  exec httpd -f -vv -p "$WEB_PORT" -h "$WWW" -c "$conf"
}

# ---------------------------------------------------------------- main

usage() {
  cat <<'USAGE'
ccorc <command> [args]      <target> is a device name, a,b,c list, or "all"

  sync   <target>                apply data/manifest/* and push data/share/* to Documents
  shell  <target> <command>      run a shell command on the device(s)
  text   <target> <text>         type text on the device(s); "Hello World" works as-is
  web                            start the web UI (container default)
  help                           show this help
USAGE
}

# First run: create the folder layout and header-only manifest files (never overwrites).
seed() { [[ -f "$1" ]] || printf '%s\n' "$2" > "$1"; }
init_data() {
  mkdir -p "$M" "$APKS" "$SHARE" "$HOME/.android" 2>/dev/null
  seed "$DEVICES"         "# <name> <ip>   e.g.  livingroom-4k 192.168.1.50"
  seed "$M/uninstall.txt" "# packages to uninstall, one per line (do not also list them in playstore.txt)"
  seed "$M/apks.txt"      "# <package> <version> <file in apks/>   installed if missing or <version> is newer than the device; e.g.  io.github.colino17.jellyshim 0.3.0 jellyshim.apk"
  seed "$M/playstore.txt" "# packages to install from the Play Store, one per line"
  seed "$M/shell.txt"     "# shell commands run on each device, one per line (appops, pm grant, settings put ...)"
  seed "$M/disable.txt"   "# packages to disable, one per line (list launchers last)"
}

for c in adb timeout sed awk; do command -v "$c" >/dev/null 2>&1 || die "missing required command: $c"; done

cmd="${1:-help}"; shift || true
case "$cmd" in help|-h|--help) usage; exit 0 ;; esac

init_data
[[ -f "$DEVICES" ]] || die "cannot create $DEVICES (is the data volume mounted and writable?)"
adb start-server >/dev/null 2>&1

case "$cmd" in
  sync)  fanout "${1:?target required}" sync_device ;;
  shell) t="${1:?target required}"; shift; (( $# )) || die "usage: ccorc shell <target> <command>"; fanout "$t" A shell "$@" ;;
  text)  t="${1:?target required}"; shift; [[ -n "$*" ]] || die "usage: ccorc text <target> <text>"; fanout "$t" do_text "$@" ;;
  web)   web ;;
  *)     usage; exit 1 ;;
esac
