#!/usr/bin/env bash

# POST COMMAND FOR SENDING TEXT
reply() { printf 'Status: %s\r\nContent-Type: text/plain\r\n\r\n%s\n' "$1" "$2"; exit 0; }

# CONTENT CONTROLS AND ERROR MESSAGES
[[ "${REQUEST_METHOD:-}" == POST ]] || reply "405 Method Not Allowed" "POST only"
[[ "${CONTENT_TYPE:-}" == application/octet-stream* ]] || reply "415 Unsupported Media Type" "Use the web UI"
dev="${QUERY_STRING#device=}"
[[ "$dev" =~ ^[A-Za-z0-9._-]+$ ]] || reply "400 Bad Request" "Invalid device"
len="${CONTENT_LENGTH:-0}"
[[ "$len" =~ ^[0-9]+$ ]] && (( len > 0 && len <= 4000 )) || reply "400 Bad Request" "Text must be 1-4000 bytes"

text="$(head -c "$len")"
if out="$(/usr/local/bin/ccorc text "$dev" "$text" 2>&1)"; then
  reply "200 OK" "$out"
else
  reply "502 Bad Gateway" "$out"
fi
